# MediSave AI — docker-compose environment (EXAMPLE).
# Copy to .env and edit. NEVER commit a real .env with real credentials.
# Docker Compose reads this file automatically.

POSTGRES_USER=medisave
POSTGRES_PASSWORD=medisave_dev_only
POSTGRES_DB=medisave

# Generate a long random value for anything beyond throwaway local dev:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
MEDISAVE_SECRET_KEY=dev-only-change-me-in-any-shared-env
MEDISAVE_DEMO_MODE=true
