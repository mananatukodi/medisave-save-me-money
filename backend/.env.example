# MediSave AI backend configuration (EXAMPLE - copy to .env and edit).
# NEVER commit a real .env. Never hardcode production credentials.

MEDISAVE_ENV=dev                       # dev | test | staging | prod
# Generate a long random secret for anything beyond local dev:
MEDISAVE_SECRET_KEY=change-me-generate-a-long-random-secret
MEDISAVE_DATABASE_URL=postgresql+psycopg://medisave:medisave@localhost:5432/medisave
# Quick local dev WITHOUT Postgres installed (SQLite):
# MEDISAVE_DATABASE_URL=sqlite:///./medisave.db

MEDISAVE_ACCESS_TOKEN_EXPIRE_MINUTES=30
MEDISAVE_REFRESH_TOKEN_EXPIRE_DAYS=7
MEDISAVE_RATE_LIMIT_ENABLED=true
MEDISAVE_SEED_ON_STARTUP=true
MEDISAVE_DEMO_MODE=true

# AI provider: none = rule-based guidance engine only (no LLM).
# "openai" REQUIRES INTEGRATION work + credentials before it functions.
MEDISAVE_AI_PROVIDER=none

# CORS (JSON array)
MEDISAVE_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
